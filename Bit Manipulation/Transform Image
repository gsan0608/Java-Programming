import java.util.*;
public class Main{
	public static void main(String[] args) {
	    Scanner in=new Scanner(System.in);
	    int n=in.nextInt();
	    int []arr=new int[n];
	    for(int i=0;i<n;i++){
	        for(int j=0;j<n;j++){
	            arr[i]=arr[i]<<1|in.nextInt();
	        }
	    }
	    int mask=(1<<n)-1;
	    for(int i=0;i<n;i++){
	        int rev=0;
	        while(arr[i]!=0){
	        rev=(rev<<1)|(arr[i]&1);
	        arr[i]=arr[i]>>1;
	        }
	        int res=rev^mask;
	        for(int j=n-1;j>=0;j--){
	          System.out.print(((res>>j)&1)+" ");
	        }
	         System.out.print("\n");
	    }
	}
}
