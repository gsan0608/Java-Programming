import java.util.*;
public class Main{
	public static void main(String[] args) {
	    Scanner in=new Scanner(System.in);
	    String s=in.nextLine();
	    int c=0,max=0;
        int n=s.length();
       String res="";
    for(int i=0;i<n;i++){
        for(int j=i+1;j<=n;j++){
            String sub=(s.substring(i,j));
            int len=sub.length();
            String rev=""; 
          for(int k=len-1;k>=0;k--){
           rev+=sub.charAt(k);
          }
          if(sub.equals(rev)){
              if(max<len){
                 res=rev
                  max=len;
              }
        }
    }
	}
	 System.out.println(res);
}
}
